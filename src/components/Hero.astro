---
import { profile } from '../data/portfolio';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-top">
    <p class="eyebrow">
      <span class="status-dot" aria-hidden="true"></span> Computer Science · University
      of Edinburgh
    </p><span class="edition">Portfolio / 2026</span>
  </div>
  <h1 id="hero-title">
    Understanding systems.<br /><span>Building useful software.</span>
  </h1>
  <div class="hero-bottom">
    <div class="hero-intro">
      <p>
        I’m Javi, a Computer Science student connecting theory with practice
        through software engineering, machine learning, and financial
        technology.
      </p><div class="actions">
        <a class="button" href="#projects"
          >Explore my work <span aria-hidden="true">↘</span></a
        ><a class="text-link" href={`mailto:${profile.email}`}
          >Get in touch <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
    <dl class="hero-note">
      <div>
        <dt>Currently</dt><dd>
          BEng Computer Science<br />Edinburgh, 2025–2029 <span>(expected)</span
          >
        </dd>
      </div><div>
        <dt>First-year average</dt><dd class="grade">89.5<span>%</span></dd>
      </div>
    </dl>
  </div>
  <div class="hero-rule">
    <span>Selected work, independent exploration & a little about me</span><a
      href="#projects"
      aria-label="Scroll to featured projects">↓</a
    >
  </div>
</section>
