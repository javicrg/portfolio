---
const { home = false } = Astro.props;
const prefix = home ? '' : '/';
---

<header class="site-header wrap">
  <a class="wordmark" href="/" aria-label="Javi Careaga home"
    ><span class="monogram" aria-hidden="true">jc<span>.</span></span><span
      >Javi Careaga</span
    ></a
  >
  <nav aria-label="Main navigation">
    <a href={`${prefix}#projects`}>Projects</a>
    <a href={`${prefix}#about`}>About</a>
    <a href={`${prefix}#experience`}>Experience</a>
    <a class="nav-contact" href={`${prefix}#contact`}
      >Let’s talk <span aria-hidden="true">↗</span></a
    >
  </nav>
</header>
