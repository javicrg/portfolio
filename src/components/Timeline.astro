---
import { experiences } from '../data/portfolio';
---

<section
  id="experience"
  class="section wrap"
  aria-labelledby="experience-title"
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">03 / Experience & leadership</p><h2
        id="experience-title"
      >
        Beyond the code.
      </h2>
    </div><p>
      Research, collaboration, and making<br class="desktop-break" /> technical ideas
      accessible.
    </p>
  </div>
  <div class="experience-list">
    {
      experiences.map((item) => (
        <article class="experience-row">
          <>
            <div>
              <>
                <p class="eyebrow">{item.context}</p>
                <h3>{item.organisation}</h3>
              </>
            </div>
            <div>
              <>
                <h4>{item.role}</h4>
                <p>{item.description}</p>
              </>
            </div>
          </>
        </article>
      ))
    }<article class="experience-row">
      <div>
        <p class="eyebrow">Previous · Independent development</p><h3>
          Pixel Labs
        </h3>
      </div><div>
        <h4>Owner & developer · FiveM scripts</h4><p>
          Built web applications and scripts for FiveM servers through Pixel
          Labs, an independent game-modding store. An earlier part of my
          experience developing software beyond the classroom.
        </p>
      </div>
    </article>
  </div>
</section>
