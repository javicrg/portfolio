---
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CalibrationChart from '../../components/CalibrationChart.astro';
import { projects, calibration as c, type Project } from '../../data/portfolio';
import dashboard from '../../assets/images/private-markets-dashboard.png';
import report from '../../assets/images/private-markets-report.png';
export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;
interface Props {
  project: Project;
}
const { project } = Astro.props;
const isFinance = project.slug === 'private-markets-tracker';
const isML = project.slug === 'language-model-calibration';
const next =
  projects[
    (projects.findIndex((p) => p.slug === project.slug) + 1) % projects.length
  ];
---

<Layout title={`${project.title} — Javi Careaga`} description={project.summary}>
  <Header />
  <main id="main" tabindex="-1" class="wrap case-study">
    <a class="text-link back-link" href="/#projects"
      ><span aria-hidden="true">←</span> All projects</a
    >
    <header class="case-header">
      <p class="eyebrow">Project {project.number} / {project.category}</p><h1>
        {project.title}
      </h1><p class="lead">{project.summary}</p><ul
        class="tags"
        aria-label="Technologies"
      >
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul><dl class="case-meta">
        <div><dt>My role</dt><dd>{project.role}</dd></div><div>
          <dt>Status</dt><dd>{project.status}</dd>
        </div>{
          project.repository && (
            <div>
              <>
                <dt>Source code</dt>
                <dd>
                  <a class="text-link" href={project.repository}>
                    View on GitHub <span aria-hidden="true">↗</span>
                  </a>
                </dd>
              </>
            </div>
          )
        }
      </dl>
    </header>
    {
      isFinance && (
        <figure class="case-screenshot">
          <>
            <Image
              src={dashboard}
              width={1280}
              height={576}
              widths={[640, 960, 1280]}
              sizes="(max-width: 700px) 100vw, 1100px"
              alt="Private Markets Tracker dashboard with fictional investor commitment totals and allocation charts"
              format="webp"
              loading="eager"
            />
            <figcaption>
              Application dashboard · Fictional demo data from the public
              repository.
            </figcaption>
          </>
        </figure>
      )
    }
    {
      isML && (
        <div class="case-experiment">
          <CalibrationChart />
          <div class="experiment-table">
            <table>
              <caption>Held-out evaluation · {c.heldOut} questions</caption>
              <thead>
                <tr>
                  <th scope="col">Metric</th>
                  {c.stages.map((stage) => (
                    <th scope="col">{stage.label}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Accuracy</th>
                  {c.stages.map((stage) => (
                    <td>{stage.accuracy.toFixed(2)}%</td>
                  ))}
                </tr>
                <tr>
                  <th scope="row">Average confidence</th>
                  {c.stages.map((stage) => (
                    <td>{stage.confidence.toFixed(2)}%</td>
                  ))}
                </tr>
                <tr>
                  <th scope="row">
                    <abbr title="Negative log-likelihood">NLL</abbr>
                  </th>
                  {c.stages.map((stage) => (
                    <td>{stage.nll}</td>
                  ))}
                </tr>
                <tr>
                  <th scope="row">
                    <abbr title="Expected calibration error">ECE</abbr>
                  </th>
                  {c.stages.map((stage) => (
                    <td>{stage.ece.toFixed(2)}%</td>
                  ))}
                </tr>
              </tbody>
            </table>
            <p>
              CommonsenseQA training split: 8,341 training / 400 validation /
              400 calibration / 600 held out. Temperature fitted only on the
              calibration partition.
            </p>
          </div>
        </div>
      )
    }
    <div class="case-body">
      <aside class="case-contents">
        <p class="eyebrow">In this project</p><nav
          aria-label="Case study contents"
        >
          {
            project.sections.map((section, i) => (
              <a href={`#section-${i + 1}`}>{section.title}</a>
            ))
          }
        </nav>
      </aside><div class="case-prose">
        {
          project.sections.map((section, i) => (
            <section id={`section-${i + 1}`}>
              <h2>{section.title}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {isFinance && i === 3 && (
                <figure class="case-screenshot">
                  <Image
                    src={report}
                    width={1280}
                    height={569}
                    widths={[640, 960, 1280]}
                    sizes="(max-width: 700px) 100vw, 760px"
                    alt="A generated fund report with annual cash-flow charts and a fictional Northstar Growth Fund position"
                    format="webp"
                    loading="lazy"
                  />
                  <figcaption>
                    Generated fund report · Fictional demo positions and
                    projections.
                  </figcaption>
                </figure>
              )}
            </section>
          ))
        }
      </div>
    </div>
    <a class="next-project" href={`/projects/${next.slug}/`}
      ><span class="eyebrow">Next project</span><span
        >{next.title} <span aria-hidden="true">↗</span></span
      ></a
    >
  </main>
  <Footer />
</Layout>
