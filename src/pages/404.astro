---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found — Javi Careaga" noindex>
  <Header />
  <main id="main" tabindex="-1" class="wrap not-found">
    <p class="eyebrow">404 / Page not found</p><h1>A missing connection.</h1><p>
      This page doesn’t exist. You can find my projects, experience, and contact
      details on the homepage.
    </p><a class="button" href="/"
      >Back to the portfolio <span aria-hidden="true">↗</span></a
    >
  </main>
  <Footer />
</Layout>
