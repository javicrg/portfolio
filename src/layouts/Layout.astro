---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { profile } from '../data/portfolio';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = profile.description,
  noindex = false,
} = Astro.props;
const canonical = new URL(
  noindex ? '/404.html' : Astro.url.pathname,
  Astro.site ?? 'https://portfolio.javic.tech/',
);
const socialImage = new URL('/social-card.png', canonical);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#121715" />
    <meta name="color-scheme" content="dark" />
    <meta
      name="google-site-verification"
      content="AuMlxg6HJG3Rwtp1H81O3OmPVW4WaI5jrk1X4Onm0hU"
    />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Javi Careaga" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Javi Careaga — Computer Science, University of Edinburgh. Software engineering, machine learning, and financial technology."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
